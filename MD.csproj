  </ItemGroup>

  <!--
    瑁佸壀鏃朵繚浣?Windows App SDK 鐨勫紩瀵肩▼搴忋€?    杩欎袱涓▼搴忛泦娌℃湁琚笟鍔′唬鐮侀潤鎬佸紩鐢紙鍚姩鏃剁敱 Windows App SDK 鐨?    module initializer 璋冪敤锛夛紝ILLink 浼氭妸瀹冧滑褰撴垚姝讳唬鐮佸垹鎺夛紱鍒犳帀涔嬪悗
    杩涚▼浼氬湪 Main 閲岀洿鎺ュ穿鍦?      Microsoft.UI.Xaml.Application.Start -> COMException 0x80040111
    锛圕lassFactory 鏃犳硶渚涘簲璇锋眰鐨勭被锛夛紝鏃ュ織閮芥潵涓嶅強鍐欍€?    瀹炴祴锛氫笉 root 鏃?41 MB 鐨勩€屽叏瑁佸垏銆峞xe 涓€鍚姩灏遍€€锛宺oot 鍚庢甯搞€?  -->
  <ItemGroup Condition="'$(PublishTrimmed)'=='true'">
    <TrimmerRootAssembly Include="Microsoft.WindowsAppRuntime.Bootstrap.Net" />
    <!--
      搴旂敤鑷韩鐨?module initializer 閲屾湁 Windows App SDK 鐨?UndockedRegFreeWinRT
      娉ㄥ唽璋冪敤锛堣 obj 鐢熸垚鐨?AutoInitialize锛夈€侷LLink 浼氭妸娌℃湁琚笟鍔′唬鐮佽皟鐢ㄧ殑
      module initializer 褰撴垚姝讳唬鐮佸垹鎺夛紝缁撴灉鏄繘绋嬪惎鍔ㄦ椂 WinRT 绫绘病鏈夋敞鍐岋細
        Microsoft.UI.Xaml.Application.Start -> COMException 0x80040111
      鏁翠釜搴旂敤鍙湁 500 KB锛宺oot 鑷繁涓嶄細褰卞搷浣撶Н銆?    -->
    <TrimmerRootAssembly Include="$(AssemblyName)" />

    <!--
      MAUI 的控件树 / DataTemplate / CollectionView 适配器大量依赖反射与
      XAML 元数据。full trim 实测会出现「文件加载成功、正文全白」：
      MdDocument 解析了 100+ 块，但 CollectionView 一个 BlockHost 都没创建。
      root 住 MAUI 程序集，保留控件工厂与模板反射；实测体积只多约 1 MB
      （41.2 MB → 42.3 MB），但正文能正常渲染。
    -->
    <TrimmerRootAssembly Include="Microsoft.Maui.Controls" />
    <TrimmerRootAssembly Include="Microsoft.Maui" />
    <TrimmerRootAssembly Include="Microsoft.Maui.Graphics" />
    <TrimmerRootAssembly Include="Microsoft.Maui.Essentials" />
    <TrimmerRootAssembly Include="Microsoft.Maui.Controls.Xaml" />
    <TrimmerRootAssembly Include="Microsoft.Maui.Graphics.Win2D.WinUI.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <!-- GB18030 / GBK 绛変腑鏂囦唬鐮侀〉鐢?.NET 10 鍩虹绫诲簱鑷甫锛圫ystem.Text.Encoding.CodePages
         宸插唴缃簬鍏变韩妗嗘灦锛夛紝鍥犳鏃犻渶鏄惧紡寮曠敤 NuGet 鍖呫€?-->
  </ItemGroup>

</Project>


