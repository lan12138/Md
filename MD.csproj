    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

    <OutputType>Exe</OutputType>
    <RootNamespace>MD</RootNamespace>
    <AssemblyName>MD</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- 搴旂敤淇℃伅 -->
    <ApplicationTitle>MD</ApplicationTitle>
    <ApplicationId>cn.md.reader</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>

    <!-- Windows锛氶潪鎵撳寘锛坲npackaged锛夋ā寮忥紝渚夸簬鐩存帴浠?exe 杩愯 -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Android锛氬彂甯?APK 鑰屼笉鏄?AAB锛屼究浜庝晶杞藉畨瑁?-->
    <AndroidPackageFormat Condition="'$(TargetFramework)'=='net10.0-android' and '$(Configuration)'=='Release'">apk</AndroidPackageFormat>
    <AndroidLinkMode Condition="'$(TargetFramework)'=='net10.0-android' and '$(Configuration)'=='Release'">SdkOnly</AndroidLinkMode>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <!--
    Windows 鍗曟枃浠惰嚜鍖呭惈鍙戝竷銆?    璇存槑锛歁AUI 鐨?Windows 绔緷璧?Windows App SDK锛岃蛋銆岃嚜鍖呭惈銆嶆墠鑳藉緱鍒?    銆屽弻鍑诲嵆鐢ㄣ€佹棤闇€瑁呰繍琛屾椂銆嶇殑鍗曚釜 exe銆備唬浠锋槸浜х墿杈冨ぇ锛堢害 150~250 MB锛夛紝
    杩欐槸 WinUI 鐨勫師鐢熶緷璧栧喅瀹氱殑锛涜嫢鎺ュ彈鐢ㄦ埛棰勮 Windows App SDK 杩愯鏃讹紝
    鍙敼鐢ㄨ剼鏈噷鐨?framework-dependent 妯″紡锛屼骇鐗╀細灏忓埌鍗佸嚑 MB銆?  -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0' and '$(Configuration)'=='Release'">
    <!--
      鈿?涓嶈鐢ㄥ懡浠よ鐨?RID 鍙傛暟锛?r锛夊拰鑷甫杩愯鏃跺紑鍏筹紙銆屽弻妯嚎 self-contained銆嶏級
      鏉ユ寚瀹?Windows 鐨勫彂甯冩柟寮忥細瀹冧滑鏄€屽叏灞€銆峂SBuild 灞炴€э紝浼氬悓鏃朵綔鐢ㄥ埌
      Android 鐩爣涓婏紝浣?Android 鍘昏繕鍘?Microsoft.NETCore.App.Runtime.Mono.win-x64
      骞舵姤 NU1102銆傝繖閲岀敤涓€涓嚜瀹氫箟灞炴€?MdWindowsRuntime 鎵挎帴锛屽彧鍦ㄦ湰 TFM 鍐呯敓鏁堬細
        dotnet publish ... -p:MdWindowsRuntime=win-arm64
    -->
    <RuntimeIdentifier Condition="'$(MdWindowsRuntime)'!=''">$(MdWindowsRuntime)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!--
      鍏ㄨ鍒囷紙full trim锛夈€傚疄娴?75.2 MB 鈫?43.3 MB锛堢害 -42%锛夛紝
      鍚姩銆侀槄璇汇€佽缃惤鐩樸€佷富棰樺垏鎹㈠潎閫氳繃瀹炶窇楠岃瘉銆?
      鈿?涓ゆ潯纭€у墠鎻愶紝缂轰竴涓嶅彲锛?      1) System.Text.Json 蹇呴』璧?AppJsonContext 婧愮敓鎴愶紙Models/AppJsonContext.cs锛夈€?         瑁佸壀鐗堥粯璁ゅ叧闂弽灏勫簭鍒楀寲锛屾病鏈変笂涓嬫枃鏃?settings.json 浼氶潤榛樺啓涓嶈繘鍘汇€?      2) WindowsAppSDK 鐨?reg-free WinRT 娓呭崟蹇呴』鎸夈€屽崟鏂囦欢妯″紡銆嶉噸鏂扮敓鎴愩€?         鏃у疄鐜板閲忓鐢ㄤ笂涓€杞潪鍗曟枃浠剁殑 Manifests\\WindowsAppSDK.manifest锛?         娓呭崟閲屽彧鏈?22 涓枃浠讹紝鍚姩鏃朵細宕╁湪
         Microsoft.UI.Xaml.Application.Start锛?x80040111锛夈€?         瑙佷笅闈㈢殑 MdRegenerateWindowsAppSdkManifest 鐩爣銆?
      鍙﹀ app 鑷韩涓?Bootstrap.Net 蹇呴』 root 浣忥紙module initializer / 寮曞浠ｇ爜锛夛紝
      瑙佷笅鏂?TrimmerRootAssembly銆?    -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- 闈㈠悜妗岄潰闃呰鍣ㄧ殑鍐呭瓨鍙栬垗锛氬伐浣滅珯 GC锛屼笉涓哄悶鍚愰噺棰勭暀鍚庡彴鍫?-->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- 瑁佸壀鏃剁殑 BCL 鐗规€у紑鍏筹細闃呰鍣ㄤ笉闇€瑕佽皟璇曞櫒/HTTP 璇婃柇浜嬩欢 -->
    <DebuggerSupport>false</DebuggerSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>

    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!--
    鍗曟枃浠跺彂甯冨繀椤讳互 RedirectDlls=true 閲嶆柊鐢熸垚 Windows App SDK 鐨?reg-free
    WinRT 娓呭崟銆傝繖涓?target 鐨勮緭鍑烘槸澧為噺澶嶇敤鐨勶紙Inputs=AppxManifest锛夛紝
    涓嶄細鎰熺煡 PublishSingleFile / PublishTrimmed 鐨勫彉鍖栵紱涓€鏃﹀鐢ㄤ笂涓€杞殑
    闈炲崟鏂囦欢娓呭崟锛宔xe 浼氬湪鍚姩鏃跺穿鍦?Microsoft.UI.Xaml.Application.Start銆?    姣忔鍗曟枃浠跺彂甯冨墠鍒犳帀涓棿娓呭崟锛屽己鍒堕噸寤恒€?  -->
  <Target Name="MdRegenerateWindowsAppSdkManifest"
          BeforeTargets="CreateWinRTRegistration"
          Condition="'$(PublishSingleFile)'=='true' and '$(SelfContainedIntermediateOutputPath)'!=''">
    <RemoveDir Directories="$(SelfContainedIntermediateOutputPath)Manifests" />
  </Target>

  <!--
    鈽?鍏煎銆屾墎骞冲竷灞€銆嶇殑闃插尽鎬ф帓闄?鈽?
    鏈伐绋嬪湪鏈湴鐨勫紑鍙戠洰褰曟槸 src/MD/锛屼絾 GitHub 浠撳簱
    锛坔ttps://github.com/lan12138/Md锛夐噷鏄妸鏈枃浠剁洿鎺ユ斁鍦ㄤ粨搴撴牴鐨勬墎骞冲竷灞€銆?    閭ｇ甯冨眬涓嬶紝SDK 榛樿鐨?**/*.cs 閫氶厤浼氭妸 tests/ 涓嬬殑鑷婧愮爜
    浠ュ強瀹冭嚜宸辩殑 obj/ 鐢熸垚鏂囦欢锛圡D.EncodingSelfCheck.AssemblyInfo.cs锛変竴骞跺悆杩涙潵锛?    浜庢槸鍜屾湰宸ョ▼鐢熸垚鐨?MD.AssemblyInfo.cs 鎾炶溅锛屾姤 CS0579銆岀壒鎬ч噸澶嶃€嶃€?
    鎺掗櫎鏉＄洰鍦ㄦ爣鍑嗗竷灞€锛坰rc/MD/锛変笅涓嶅尮閰嶄换浣曟枃浠讹紝灞炰簬绌烘搷浣滐紝
    鍥犳涓ょ甯冨眬鍏辩敤鍚屼竴浠藉伐绋嬫枃浠讹紝涓嶉渶瑕佺淮鎶や袱涓増鏈€?  -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Page Remove="tests/**" />
    <MauiXaml Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <!-- 鍥炬爣涓庡惎鍔ㄥ浘锛堢煝閲?SVG锛岀敱 MAUI Resizetizer 鐢熸垚鍚勫钩鍙板昂瀵革級 -->
  <ItemGroup>
