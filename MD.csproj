<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      浜や粯鐩爣锛?*鍙湁 Windows**銆?
      Android 鐩爣宸插仠鐢?鈥斺€?鎵嬫満绔敮鎸?Markdown 鐨勫簲鐢ㄥ凡缁忚冻澶熷锛岃嚜鐮旀病鏈変环鍊笺€?      Platforms/Android 娓呭崟涓?build/publish-android.ps1 閮戒繚鐣欑潃锛岄渶瑕佹椂鎶婁笅闈?      绗竴琛岀殑娉ㄩ噴鎹㈠洖澶氱洰鏍囧啓娉曞嵆鍙仮澶嶏紙.NET 10 鐨?net10.0-android 闇€瑕?      Android SDK 鐨?platforms/android-36锛屽弬鑰?docs/PLATFORMS.md锛夈€?
      macOS(Mac Catalyst) 鍚岀悊锛屼笖蹇呴』鍦?macOS 涓婃瀯寤恒€?    -->
    <!--
      娉ㄦ剰杩欓噷鏄?*鍗曟暟** TargetFramework锛氬彧闈㈠悜涓€涓鏋舵椂蹇呴』鐢ㄥ崟鏁帮紝
      鍚﹀垯 MSBuild 浠嶆寜銆屽鐩爣銆嶅鐞嗭紝dotnet publish 浼氭姤
      NETSDK1129锛堝繀椤绘樉寮忔寚瀹?-f锛夈€?      鎭㈠澶氬钩鍙版椂鎶婂畠鏀瑰洖澶嶆暟鐨?TargetFrameworks 鍗冲彲锛屼緥濡傦細
        <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0-android</TargetFrameworks>
